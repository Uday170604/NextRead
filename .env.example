# NextRead configuration - copy to .env (loaded automatically; real environment variables win)
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
# SQLite by default. The file name is unchanged from earlier versions so existing databases keep working.
DATABASE_URL=sqlite:///./bookrec.db
# Seeds 50 books (with covers, page counts, mood tags), demo readers and ratings on an EMPTY database. Set false in production.
SEED_ON_STARTUP=true
ADMIN_EMAIL=admin@bookrec.local
ADMIN_PASSWORD=ChangeMe123!
ACCESS_TOKEN_EXPIRE_MINUTES=480
